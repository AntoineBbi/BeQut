)
colnames(pred) <- c("y", paste0("fitted.q", object$control$tau), "lower", "upper")
# Get back objects to fit distribution parameters
if(is.null(newdata)){
X <- object$jags$jags.data$X
I <- object$jags$jags.data$I
y <- object$jags$jags.data$y
}else{
# data
tmp <- newdata[c(all.vars(frm))]
tmp <- as.data.frame(unique(tmp))
y <- tmp[all.vars(frm)][, 1]
I <- nrow(tmp)
# design matrices
frm2 <- frm
frm2[[2]] <- NULL
tmp <- as.data.frame(
unique(newdata[all.vars(frm2)])
)
X <- stats::model.matrix(frm2, data = tmp)
}
get_cols <- function(pattern) grep(pattern, colnames(post_mat))
beta_cols  <- get_cols("^beta\\[")
# Get posterior mean of parameters and Compute distribution parameter for each observed Y
beta_bar  <- colMeans(post_mat[, beta_cols,  drop = FALSE])
mu   <- as.vector(X %*% beta_bar)
## draw iterations from posterior sample
S_total <- nrow(post_mat)
if (is.null(S)) {
idx <- seq_len(S_total)
} else {
S   <- min(as.integer(S), S_total)
idx <- round(seq(1, S_total, length.out = S))
}
post_mat <- post_mat[idx, , drop = FALSE]
S_eff <- nrow(post_mat)
## conditionnal linear predictor
mu_draws <- matrix(NA_real_, nrow = S_eff, ncol = I)
for (s in seq_len(S_eff)) {
beta_s <- post_mat[s, beta_cols]
mu_draws[s, ] <- as.vector(X %*% beta_s)
}
# output
pred <- data.frame(cbind(y = y,
fitted.quantile = mu,
lower = apply(mu_draws, 2, quantile, probs = 0.025),
upper = apply(mu_draws, 2, quantile, probs = 0.975))
)
colnames(pred) <- c("y", paste0("fitted.q", object$control$tau), "lower", "upper")
pred
plot.Blqm <- function(object,
var.x,
n.grid = 100,
S = NULL,
lwd = 1,
level = 0.95,
...) {
stopifnot(inherits(object, "Blqm"))
if (missing(var.x)) {
stop(
"The argument 'var.x' must be specified."
)
}
if (length(var.x) != 1L || !is.character(var.x)) {
stop("'var.x' must be a single variable name.")
}
if (!is.numeric(n.grid) || length(n.grid) != 1L ||
is.na(n.grid) || n.grid < 2 || n.grid != as.integer(n.grid)) {
stop("'n.grid' must be an integer greater than or equal to 2.")
}
if (!is.numeric(level) || length(level) != 1L ||
is.na(level) || level <= 0 || level >= 1) {
stop("'level' must be between 0 and 1.")
}
df   <- object$data
post <- as.matrix(object$jags$out_jags$samples)
frm  <- object$control$formula
if (!var.x %in% names(df)) {
stop(sprintf("'%s' is not a data variable.", var.x))
}
# --------------------------------------------------
# 1. Identify the response and explanatory variables
# --------------------------------------------------
response <- all.vars(frm[[2]])
if (length(response) != 1L) {
stop("The response must be a single variable.")
}
y_name <- response
if (!y_name %in% names(df)) {
stop("The response variable is absent from object$data.")
}
# The covariate must belong to the right-hand side
rhs <- stats::delete.response(stats::terms(frm))
rhs_vars <- all.vars(rhs)
if (!var.x %in% rhs_vars) {
stop("'var.x' must appear in the right-hand side of the formula.")
}
# --------------------------------------------------
# 2. Select posterior iterations
# --------------------------------------------------
S_total <- nrow(post)
if (S_total == 0L) {
stop("No posterior iterations are available.")
}
if (is.null(S)) {
idx <- seq_len(S_total)
} else {
if (length(S) != 1L || !is.numeric(S) ||
is.na(S) || !is.finite(S) ||
S < 1 || S != as.integer(S)) {
stop("'S' must be a positive integer or NULL.")
}
S <- min(as.integer(S), S_total)
idx <- unique(
round(seq(1, S_total, length.out = S))
)
}
post <- post[idx, , drop = FALSE]
# --------------------------------------------------
# 3. Extract posterior draws of beta
# --------------------------------------------------
beta_cols <- grep(
"^beta\\[[0-9]+\\]$",
colnames(post)
)
if (length(beta_cols) == 0L) {
stop("No posterior coefficients named 'beta[i]' were found.")
}
# Ensure numerical ordering: beta[1], beta[2], ..., beta[10]
beta_names <- colnames(post)[beta_cols]
beta_index <- as.integer(
sub("^beta\\[([0-9]+)\\]$", "\\1", beta_names)
)
beta_cols <- beta_cols[order(beta_index)]
beta_draws <- post[, beta_cols, drop = FALSE]
# --------------------------------------------------
# 4. Observed data
# --------------------------------------------------
dsub <- df[, c(y_name, rhs_vars), drop = FALSE]
dsub <- dsub[
stats::complete.cases(dsub[, c(y_name, var.x), drop = FALSE]),
,
drop = FALSE
]
if (nrow(dsub) == 0L) {
stop("No complete observations are available.")
}
if (!is.numeric(dsub[[var.x]])) {
stop("'var.x' must be numeric.")
}
x_min <- min(dsub[[var.x]])
x_max <- max(dsub[[var.x]])
# --------------------------------------------------
# 5. Construct the prediction grid
# --------------------------------------------------
x_grid <- seq(
from = x_min,
to = x_max,
length.out = as.integer(n.grid)
)
# Fix all other covariates at representative values
representative <- function(x) {
if (is.numeric(x)) {
return(stats::median(x, na.rm = TRUE))
}
if (is.factor(x)) {
tab <- table(x)
return(factor(
names(tab)[which.max(tab)],
levels = levels(x),
ordered = is.ordered(x)
))
}
if (is.logical(x)) {
return(names(which.max(table(x))))
}
x <- as.factor(x)
tab <- table(x)
factor(
names(tab)[which.max(tab)],
levels = levels(x)
)
}
newdata <- dsub[rep(1L, length(x_grid)), , drop = FALSE]
for (v in rhs_vars) {
if (v != var.x) {
newdata[[v]] <- representative(dsub[[v]])
}
}
newdata[[var.x]] <- x_grid
# --------------------------------------------------
# 6. Design matrix
# --------------------------------------------------
X <- stats::model.matrix(
rhs,
data = newdata
)
if (ncol(X) != ncol(beta_draws)) {
stop(
sprintf(
paste0(
"The design matrix has %d columns, but ",
"%d posterior beta coefficients were found. ",
"Check the correspondence between beta and model.matrix."
),
ncol(X),
ncol(beta_draws)
)
)
}
# --------------------------------------------------
# 7. Posterior predictions
# --------------------------------------------------
# Rows = grid points; columns = posterior draws
pred_draws <- X %*% t(beta_draws)
pred_mean <- rowMeans(pred_draws)
alpha <- (1 - level) / 2
pred_low <- apply(
pred_draws,
1,
stats::quantile,
probs = alpha,
na.rm = TRUE
)
pred_high <- apply(
pred_draws,
1,
stats::quantile,
probs = 1 - alpha,
na.rm = TRUE
)
pred <- data.frame(
x = x_grid,
fit = pred_mean,
lower = pred_low,
upper = pred_high
)
# --------------------------------------------------
# 8. Plot
# --------------------------------------------------
p <- ggplot2::ggplot() +
ggplot2::geom_point(
data = dsub,
mapping = ggplot2::aes(
x = .data[[var.x]],
y = .data[[y_name]]
),
...
) +
ggplot2::geom_ribbon(
data = pred,
mapping = ggplot2::aes(
x = x,
ymin = lower,
ymax = upper
),
alpha = 0.2
) +
ggplot2::geom_line(
data = pred,
mapping = ggplot2::aes(
x = x,
y = fit
),
linewidth = lwd
) +
ggplot2::labs(
x = var.x,
y = y_name
) +
ggplot2::theme_minimal()
print(p)
invisible(pred)
}
plot.Blqm(object = lqm_025, var.x = "vent_vit_moy")
#---- Fit regression model for the first quartile
lqm_025 <- BeQut::lqm(formula = h110d~vent_vit_moy + pression,
data = wave,
